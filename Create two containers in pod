apiVersion: v1
kind: Pod
metadata:
  name: gpu-pod-1
  namespace: dgx-i-giindia-aiml-siva-restricted
  labels:
    app: gpu-workload
spec:
  restartPolicy: OnFailure
  containers:
    - name: pytorch
      image: nvcr.io/nvidia/pytorch:26.09-py3
      command: ["/bin/bash", "-c", "sleep infinity"]
      ports:
        - containerPort: 8888
          name: http
      resources:
        requests:
          cpu: "8"
          memory: "18Gi"
          nvidia.com/mig-1g.18gb: 1
        limits:
          cpu: "8"
          memory: "18Gi"
          nvidia.com/mig-1g.18gb: 1
---
apiVersion: v1
kind: Pod
metadata:
  name: gpu-pod-2
  namespace: dgx-i-giindia-aiml-siva-restricted
  labels:
    app: gpu-workload
spec:
  restartPolicy: OnFailure
  containers:
    - name: pytorch
      image: nvcr.io/nvidia/pytorch:26.09-py3
      command: ["/bin/bash", "-c", "sleep infinity"]
      ports:
        - containerPort: 8888
          name: http
      resources:
        requests:
          cpu: "8"
          memory: "14Gi"
          nvidia.com/mig-1g.18gb: 1
        limits:
          cpu: "8"
          memory: "14Gi"
          nvidia.com/mig-1g.18gb: 1
---
apiVersion: v1
kind: Service
metadata:
  name: gpu-service
  namespace: dgx-i-giindia-aiml-siva-restricted
spec:
  type: NodePort
  selector:
    app: gpu-workload
  ports:
    - name: http
      port: 8888
      targetPort: 8888
      protocol: TCP
